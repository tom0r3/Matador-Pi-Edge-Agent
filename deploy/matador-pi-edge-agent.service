[Unit]
Description=Matador Pi Edge Agent
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=matador-edge
Group=matador-edge
WorkingDirectory=/opt/matador-pi-edge-agent
EnvironmentFile=-/etc/matador-pi-edge-agent.env
ExecStart=/opt/matador-pi-edge-agent/.venv/bin/python -m edge_agent.pi_edge_agent
Restart=always
RestartSec=5
StateDirectory=matador-pi-edge-agent
PrivateTmp=true
AmbientCapabilities=CAP_NET_BIND_SERVICE
# Keep the agent unprivileged while allowing the audited sudo allow-list to
# switch identity for root-owned maintenance units and hostname updates.
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_SETUID CAP_SETGID

[Install]
WantedBy=multi-user.target
