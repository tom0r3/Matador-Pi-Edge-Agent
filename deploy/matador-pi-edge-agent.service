[Unit]
Description=Matador Pi Edge Agent
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=matador-edge
Group=matador-edge
WorkingDirectory=/opt/matador-pi-edge-agent
EnvironmentFile=-/etc/matador-pi-edge-agent.env
ExecStart=/opt/matador-pi-edge-agent/.venv/bin/python -m edge_agent.pi_edge_agent
Restart=always
RestartSec=5
StateDirectory=matador-pi-edge-agent
PrivateTmp=true
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
